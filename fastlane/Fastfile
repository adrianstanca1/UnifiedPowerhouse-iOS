default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    scan(
      workspace: "UnifiedPowerhouse.xcworkspace",
      scheme: "UnifiedPowerhouse",
      device: "iPhone 15 Pro"
    )
  end

  desc "Build app"
  lane :build do
    gym(
      workspace: "UnifiedPowerhouse.xcworkspace",
      scheme: "UnifiedPowerhouse",
      configuration: "Release",
      export_method: "app-store"
    )
  end

  desc "Deploy to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: "UnifiedPowerhouse.xcodeproj")
    
    build_app(
      workspace: "UnifiedPowerhouse.xcworkspace",
      scheme: "UnifiedPowerhouse",
      export_method: "app-store"
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      notify_external_testers: false
    )
  end

  desc "Deploy to App Store"
  lane :release do
    increment_build_number(xcodeproj: "UnifiedPowerhouse.xcodeproj")
    
    build_app(
      workspace: "UnifiedPowerhouse.xcworkspace",
      scheme: "UnifiedPowerhouse",
      export_method: "app-store"
    )
    
    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false
    )
  end
end
